  "description": "KingSide Coach — browser chess trainer that turns your own games into puzzles (web port of King Coach)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node tools/copy-engine.mjs && vite",
