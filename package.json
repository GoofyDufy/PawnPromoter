    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "chessground": "9.2.1",
    "chessops": "0.15.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stockfish": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
